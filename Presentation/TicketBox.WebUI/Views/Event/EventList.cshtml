@model List<TicketBox.Application.Features.Mediator.Events.Results.GetEventQueryResult>

@{
    Layout = null;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br />
    <a href="/Event/CreateEvent" class="btn btn-success">Yeni Etkinlik</a>
    <br /><br />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Başlık</th>
                <th>Tarih</th>
                <th>Konum</th>
                <th>Kapasite</th>
                <th>Fiyat</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.EventDate.ToShortDateString()</td>
                    <td>@item.Location</td>
                    <td>@item.Capacity</td>
                    <td>@item.Price ₺</td>
                    <td>
                        <a href="/Event/UpdateEvent/@item.EventId" class="btn btn-warning btn-sm">Güncelle</a>
                        <a href="/Event/RemoveEvent/@item.EventId" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>